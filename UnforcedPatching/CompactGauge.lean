import UnforcedPatching.ConeOperator
import Mathlib.Analysis.Calculus.Deriv.Add
import Mathlib.Analysis.Calculus.Deriv.Mul

/-!
# Radial derivative identity for an axisymmetric compact gauge

For an annular smooth scalar profile `F(r,z)` set
`K = r ∂ᵣF` and `C = K + F`. This file formally checks the radial
identity `∂ᵣC = ∂ᵣK + K/r` at every positive radius. Together with
the standard cylindrical divergence formula it means that the
two-diagonal stress `K eᵣ⊗eᵣ + C e_z⊗e_z` has divergence `∇C`.

Only the one-dimensional differential identity is proved in Lean here.
Compact support, cylindrical tensor calculus, the positive stress cone,
and source-matched weighted H8 bounds are NOT formalized by this file.
-/

noncomputable section

namespace UnforcedPatching

/-- Radial component of the two-diagonal gauge generated by `F`. -/
def radialCarrier (_F Fr : ℝ → ℝ) (r : ℝ) : ℝ := r * Fr r

/-- Axial diagonal component generated by the same scalar profile. -/
def axialCarrier (F Fr : ℝ → ℝ) (r : ℝ) : ℝ := radialCarrier F Fr r + F r

/-- Radial differential compatibility needed for a pure-gradient
cylindrical divergence. `Fr` is explicitly assumed to be the radial
derivative of `F` at the point, not just a symbolic unrelated function. -/
theorem radial_axial_carrier_derivative (F Fr : ℝ → ℝ) (r a : ℝ)
    (hr : r ≠ 0) (hF : HasDerivAt F (Fr r) r)
    (hFr : HasDerivAt Fr a r) :
    deriv (axialCarrier F Fr) r =
      deriv (radialCarrier F Fr) r + radialCarrier F Fr r / r := by
  have hK : HasDerivAt (radialCarrier F Fr) (Fr r + r * a) r := by
    convert (hasDerivAt_id' (𝕜 := ℝ) r).mul hFr using 1
    · rfl
    · rfl
    · funext t
      rfl
    · ring
  have hC : HasDerivAt (axialCarrier F Fr) ((Fr r + r * a) + Fr r) r := by
    exact hK.add hF
  rw [hC.deriv, hK.deriv]
  simp only [radialCarrier]
  field_simp [hr]

end UnforcedPatching
